# ============================================
# 生产环境变量配置
# 复制为 .env 后修改: cp .env.example .env
# ============================================

# 数据库密码（请修改为强密码）
DB_PASSWORD=your_strong_password_here

# InfluxDB 配置
INFLUXDB_PASSWORD=your_influxdb_password_here
INFLUXDB_TOKEN=your_influxdb_token_here

# 后端配置
APP_ENV=production
APP_SECRET_KEY=your_secret_key_here
